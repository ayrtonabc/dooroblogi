---
/**
 * Flagi jako inline SVG.
 *
 * Emoji 🇵🇱🇬🇧🇩🇪 renderują się jako literki „PL", „GB", „DE" na
 * systemach bez glifów flag (Electron, część Linuxów, starsze Windows).
 * SVG zawsze się pokaże — a flagi mają być widoczne, bo to wymóg klienta.
 */
interface Props {
  code: 'pl' | 'en' | 'de';
  class?: string;
}

const { code, class: className } = Astro.props;
const size = { width: 20, height: 13 };
---

{
  code === 'pl' && (
    <svg
      class={className}
      width={size.width}
      height={size.height}
      viewBox="0 0 60 30"
      role="img"
      aria-hidden="true"
      focusable="false"
    >
      <rect width="60" height="30" fill="#ffffff" />
      <rect y="15" width="60" height="15" fill="#dc143c" />
    </svg>
  )
}

{
  code === 'en' && (
    <svg
      class={className}
      width={size.width}
      height={size.height}
      viewBox="0 0 60 30"
      role="img"
      aria-hidden="true"
      focusable="false"
    >
      <rect width="60" height="30" fill="#012169" />
      <path d="M0 0 L60 30 M60 0 L0 30" stroke="#ffffff" stroke-width="6" />
      <path d="M0 0 L60 30 M60 0 L0 30" stroke="#c8102e" stroke-width="3.5" />
      <path d="M30 0 V30 M0 15 H60" stroke="#ffffff" stroke-width="10" />
      <path d="M30 0 V30 M0 15 H60" stroke="#c8102e" stroke-width="6" />
    </svg>
  )
}

{
  code === 'de' && (
    <svg
      class={className}
      width={size.width}
      height={size.height}
      viewBox="0 0 60 30"
      role="img"
      aria-hidden="true"
      focusable="false"
    >
      <rect width="60" height="10" fill="#000000" />
      <rect y="10" width="60" height="10" fill="#dd0000" />
      <rect y="20" width="60" height="10" fill="#ffce00" />
    </svg>
  )
}
