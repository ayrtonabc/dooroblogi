---
import { Image } from 'astro:assets';
import CtaBand from '../components/CtaBand.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { image } from '../content/images';
import { gallery } from '../content/pages';
import { company, whatsappUrl } from '../content/company';
import { pathFor, quoteHref, type Locale } from '../i18n';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/**
 * Fotos de la galería. `wide` ocupa la fila entera; `ratio` sirve para las
 * imágenes que NO se pueden recortar (ver `.gallery-grid__item--natural`).
 */
interface GalleryPhoto {
  src: string;
  alt: Record<Locale, string>;
  caption: Record<Locale, string>;
  wide?: boolean;
  ratio?: string;
  /** Banda a lo ancho (una fila entera). Para fotos con rótulos impresos. */
  full?: boolean;
}

const photos: GalleryPhoto[] = [
  {
    src: 'hero-oblog-debowy.jpg',
    alt: {
      pl: 'Obłóg dębowy z naturalnym krawędziem na stosie desek',
      en: 'An oak trim batten with a natural edge resting on a stack of boards',
      de: 'Eine Eichen-Abschlussleiste mit Naturkante auf einem Stapel Bretter',
    },
    caption: {
      pl: 'Obłóg z naturalną krawędzią',
      en: 'Trim batten with a natural edge',
      de: 'Abschlussleiste mit Naturkante',
    },
    wide: true,
  },
  {
    src: 'sedo-warianty.png',
    alt: {
      pl: 'Dwa warianty paneli sufitowych SEDO: bez sęków i z sękami',
      en: 'Two SEDO ceiling panel variants: knot-free and with knots',
      de: 'Zwei Varianten von SEDO-Deckenpaneelen: ohne Äste und mit Ästen',
    },
    caption: {
      pl: 'Panele SEDO z naszego dębu',
      en: 'SEDO panels from our oak',
      de: 'SEDO-Paneele aus unserer Eiche',
    },
    // Banda a lo ancho con su proporción real: el gráfico lleva rótulos
    // impresos («Bez nud» / «Z nudami») y recortado a 3/4 los perdía.
    ratio: '3 / 2',
    full: true,
  },
  {
    src: 'sufit-sedo-realny.jpg',
    alt: {
      pl: 'Sufit z paneli dębowych z wpuszczonymi punktami świetlnymi',
      en: 'Oak panel ceiling with recessed spotlights',
      de: 'Eichenpaneel-Decke mit eingelassenen Spots',
    },
    caption: {
      pl: 'Sufit z paneli dębowych',
      en: 'Oak panel ceiling',
      de: 'Decke aus Eichenpaneelen',
    },
  },
  {
    src: 'oblog-w-hali.jpg',
    alt: {
      pl: 'Obłogi dębowe ułożone w hali — widać przekrój i profil wykończenia',
      en: 'Oak trim battens stacked in the workshop — the cross-section and the finish profile are visible',
      de: 'Eichen-Abschlussleisten in der Halle gestapelt — Querschnitt und Abschlussprofil sichtbar',
    },
    caption: {
      pl: 'Obłogi w hali',
      en: 'Battens in the workshop',
      de: 'Leisten in der Halle',
    },
  },
  {
    src: 'pomiar-oblogu.jpg',
    alt: {
      pl: 'Deska dębowa z taśmą mierniczą na stanowisku w hali',
      en: 'An oak board with a measuring tape on the workshop bench',
      de: 'Ein Eichenbrett mit Maßband auf der Werkbank',
    },
    caption: {
      pl: 'Pomiar na wymiar',
      en: 'Cut to measure',
      de: 'Auf Maß zugeschnitten',
    },
    wide: false,
  },
  {
    src: 'deski-na-placu.jpg',
    alt: {
      pl: 'Deski dębowe ułożone na placu, ze świerkami w tle',
      en: 'Oak boards stacked in the yard, with fir trees in the background',
      de: 'Eichenbretter auf dem Hof gestapelt, im Hintergrund Tannen',
    },
    caption: {
      pl: 'Drewno na placu',
      en: 'Timber in the yard',
      de: 'Holz auf dem Hof',
    },
  },
  {
    src: 'oblog-na-desce.jpg',
    alt: {
      pl: 'Obłóg dębowy cięty położony na drewnianym tarasie',
      en: 'A cut oak trim batten resting on a wooden deck',
      de: 'Eine geschnittene Eichen-Abschlussleiste auf einem Holzhof',
    },
    caption: {
      pl: 'Obłóg cięty',
      en: 'Cut trim batten',
      de: 'Geschnittene Abschlussleiste',
    },
