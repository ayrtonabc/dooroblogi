      en: 'Natural oak boards with a visible knot pattern',
      de: 'Natürliche Eichenbretter mit sichtbarem Astmuster',
    },
    caption: {
      pl: 'Dąb naturalny',
      en: 'Natural oak',
      de: 'Natürliche Eiche',
    },
    wide: false,
  },
  {
    src: 'dab-z-sakami.jpg',
    alt: {
      pl: 'Zbliżenie na dąb z sękami',
      en: 'Close-up of oak with knots',
      de: 'Nahaufnahme von Eiche mit Ästen',
    },
    caption: {
      pl: 'Dąb z sękami',
      en: 'Oak with knots',
      de: 'Eiche mit Ästen',
    },
    wide: false,
  },
  {
    src: 'panele-scienne-dab.jpg',
    alt: {
      pl: 'Ściana wykończona poziomymi deskami dębowymi',
      en: 'A wall finished with horizontal oak boards',
      de: 'Eine Wand mit waagerechten Eichenbrettern',
    },
    caption: {
      pl: 'Panele ścienne',
      en: 'Wall panels',
      de: 'Wandpaneele',
    },
    wide: false,
  },
  {
    src: 'oblog-wedzony.jpg',
    alt: {
      pl: 'Wędzony obłóg dębowy — ciemne deski w pracowni',
      en: 'Smoked oak trim battens — dark boards in the workshop',
      de: 'Geräucherte Eichen-Abschlussleisten — dunkle Bretter in der Werkstatt',
    },
    caption: {
      pl: 'Dąb wędzony',
      en: 'Smoked oak',
      de: 'Geräucherte Eiche',
    },
    wide: false,
  },
  {
    src: 'deski-z-sakami.jpg',
    alt: {
      pl: 'Dwie deski dębowe z sękami w naturalnej selekcji',
      en: 'Two oak boards with knots in the natural selection',
      de: 'Zwei Eichenbretter mit Ästen in natürlicher Selektion',
    },
    caption: {
      pl: 'Deski z sękami',
      en: 'Boards with knots',
      de: 'Bretter mit Ästen',
    },
  },
];

const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: pathFor(locale, 'home') },
  { label: t(locale, 'nav.projects') },
];

const waText = t(locale, 'wa.quote');
---

<Breadcrumbs items={breadcrumbs} locale={locale} />

<section class="section section--paper page-head">
  <div class="container">
    <div class="page-head__inner">
      <p class="kicker">{gallery.kicker[locale]}</p>
      <h1 class="page-head__title">{gallery.title[locale]}</h1>
      <p class="lede">{gallery.lead[locale]}</p>
    </div>
  </div>
</section>

<section class="section section--tight section--cream">
  <div class="container">
    <div class="prose">
      {gallery.body[locale].map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<section class="section section--tight section--paper">
  <div class="container">
    <div class="gallery-grid gallery-grid--page">
      {
        photos.map((photo) => (
          <figure
            class:list={[
              'gallery-grid__item',
              photo.wide && 'gallery-grid__item--wide',
              photo.ratio && 'gallery-grid__item--natural',
              photo.full && 'gallery-grid__item--full',
            ]}
            style={photo.ratio ? `--tile-ratio: ${photo.ratio}` : undefined}
          >
            <Image
              src={image(photo.src)}
              alt={photo.alt[locale]}
              widths={[400, 640, 960, 1280]}
              sizes={
                photo.full
                  ? '(min-width: 54rem) 92vw, 92vw'
                  : photo.wide
                    ? '(min-width: 54rem) 62vw, 92vw'
                    : '(min-width: 54rem) 31vw, 45vw'
              }
              loading="lazy"
              decoding="async"
            />
            <figcaption class="gallery-grid__caption">{photo.caption[locale]}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<CtaBand
  title={t(locale, 'gallery.ctaTitle')}
  text={t(locale, 'gallery.ctaText')}
  primaryLabel={t(locale, 'cta.quote')}
  primaryHref={quoteHref(locale)}
  secondaryLabel={t(locale, 'cta.call')}
  secondaryHref={`tel:${company.phoneE164}`}
  whatsappLabel={t(locale, 'form.whatsapp')}
  whatsappHref={whatsappUrl(waText)}
/>
