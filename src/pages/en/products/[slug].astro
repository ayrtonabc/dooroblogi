---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductView from '../../../views/ProductView.astro';
import { products } from '../../../content/products';
import { productPath } from '../../../i18n';

const locale = 'en' as const;

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug.en },
    props: { product },
  }));
}

const { product } = Astro.props;

const alternates = {
  pl: productPath('pl', product.slug.pl),
  en: productPath('en', product.slug.en),
  de: productPath('de', product.slug.de),
};

const path = productPath(locale, product.slug.en);
---

<BaseLayout
  locale={locale}
  path={path}
  title={product.seoTitle.en}
  description={product.seoDescription.en}
  alternates={alternates}
  ogImage={`/og/${product.id}-en.jpg`}
  ogImageAlt={product.image.alt.en}
>
  <ProductView locale={locale} product={product} />
</BaseLayout>
