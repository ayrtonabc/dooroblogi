---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductView from '../../views/ProductView.astro';
import { products } from '../../content/products';
import { productPath } from '../../i18n';

const locale = 'pl' as const;

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug.pl },
    props: { product },
  }));
}

const { product } = Astro.props;

const alternates = {
  pl: productPath('pl', product.slug.pl),
  en: productPath('en', product.slug.en),
  de: productPath('de', product.slug.de),
};

const path = productPath(locale, product.slug.pl);
---

<BaseLayout
  locale={locale}
  path={path}
  title={product.seoTitle.pl}
  description={product.seoDescription.pl}
  alternates={alternates}
  ogImage={`/og/${product.id}-pl.jpg`}
  ogImageAlt={product.image.alt.pl}
>
  <ProductView locale={locale} product={product} />
</BaseLayout>
