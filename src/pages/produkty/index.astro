---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogView from '../../views/CatalogView.astro';

const locale = 'pl' as const;
const path = '/produkty/';

const alternates = {
  pl: '/produkty/',
  en: '/en/products/',
  de: '/de/produkte/',
} as Partial<Record<typeof locale, string>>;
---

<BaseLayout
  locale={locale}
  path={path}
  title="Obłogi dębowe, lamele dębowe i panele"
  description="Obłogi dębowe, lamela dębowa 4–8 mm i panele sufitowe i ścienne z jednego naturalnego dębu. Wszystko cięte na wymiar. Wycena na zapytanie."
  alternates={alternates}
>
  <CatalogView locale={locale} />
</BaseLayout>
