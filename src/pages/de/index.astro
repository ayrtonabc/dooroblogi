---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeView from '../../views/HomeView.astro';
import { home } from '../../content/pages';
import { heroImage } from '../../content/hero';
import { definedTermSchema } from '../../content/schema';

const locale = 'de' as const;
const path = '/de/';

const alternates = { pl: '/', en: '/en/', de: '/de/' } as Partial<Record<typeof locale, string>>;

/** Same generator as the `<img>` in `HomeView` — preload and image must match. */
const heroAsset = await heroImage();
---

<BaseLayout
  locale={locale}
  path={path}
  title={home.seo.title[locale]}
  description={home.seo.description[locale]}
  alternates={alternates}
  jsonLd={[definedTermSchema(locale)]}
  preloadImage={{
    href: heroAsset.src,
    type: 'image/webp',
    srcset: heroAsset.srcset,
    sizes: heroAsset.sizes,
  }}
>
  <HomeView locale={locale} />
</BaseLayout>
